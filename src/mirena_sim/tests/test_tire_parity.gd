class_name TestTireParity
extends SceneTree

## Numerical Parity Test between Python MF 6.2 / PyTorch and Godot GDScript Implementation
## Runs 405 test vectors generated by Python and verifies maximum relative error < 1e-3.

const TireModelScript = preload("res://Scenes/Vehicle/Dynamics/Tires/TireModel.gd")

func _init() -> void:
	var res = run()
	if res["failed"] == 0:
		quit(0)
	else:
		quit(1)

static func run() -> Dictionary:
	var passed: int = 0
	var failed: int = 0
	var errors: Array[String] = []
	
	var json_path = "res://tests/parity_test_cases.json"
	if not FileAccess.file_exists(json_path):
		errors.append("Parity test cases file not found: " + json_path)
		return {"name": "test_tire_parity", "passed": 0, "failed": 1, "errors": errors}
		
	var file = FileAccess.open(json_path, FileAccess.READ)
	var text = file.get_as_text()
	var data = JSON.parse_string(text)
	
	if not (data is Dictionary) or not data.has("cases"):
		errors.append("Invalid parity test cases format.")
		return {"name": "test_tire_parity", "passed": 0, "failed": 1, "errors": errors}
		
	var cases: Array = data["cases"]
	var total_cases = cases.size()
	
	var max_err_fy_mf: float = 0.0
	var max_err_mz_mf: float = 0.0
	var max_err_fx_mf: float = 0.0
	var max_err_delta_fy: float = 0.0
	var max_err_delta_mz: float = 0.0
	var max_err_fy_total: float = 0.0
	var max_err_mz_total: float = 0.0
	
	const TOLERANCE: float = 1e-3 # 0.1% or 0.05 N
	
	for idx in range(total_cases):
		var c: Dictionary = cases[idx]
		var inp: Dictionary = c["inputs"]
		var exp: Dictionary = c["expected"]
		
		var k = float(inp["kappa"])
		var a = float(inp["alpha"])
		var fz = float(inp["f_z"])
		var g = float(inp["gamma"])
		var p = float(inp["p_kpa"])
		var vx = float(inp["v_x"])
		
		var res = TireModelScript.compute_forces(k, a, fz, null, g, p, vx, true)
		
		var err_fy_mf = absf(res["Fy_mf"] - exp["Fy_mf"]) / maxf(absf(exp["Fy_mf"]), 1.0)
		var err_mz_mf = absf(res["Mz_mf"] - exp["Mz_mf"]) / maxf(absf(exp["Mz_mf"]), 1.0)
		var err_fx_mf = absf(res["Fx_mf"] - exp["Fx_mf"]) / maxf(absf(exp["Fx_mf"]), 1.0)
		var err_delta_fy = absf(res["delta_Fy"] - exp["delta_Fy"]) / maxf(absf(exp["delta_Fy"]), 1.0)
		var err_delta_mz = absf(res["delta_Mz"] - exp["delta_Mz"]) / maxf(absf(exp["delta_Mz"]), 1.0)
		var err_fy_tot = absf(res["Fy"] - exp["Fy"]) / maxf(absf(exp["Fy"]), 1.0)
		var err_mz_tot = absf(res["Mz"] - exp["Mz"]) / maxf(absf(exp["Mz"]), 1.0)
		
		max_err_fy_mf = maxf(max_err_fy_mf, err_fy_mf)
		max_err_mz_mf = maxf(max_err_mz_mf, err_mz_mf)
		max_err_fx_mf = maxf(max_err_fx_mf, err_fx_mf)
		max_err_delta_fy = maxf(max_err_delta_fy, err_delta_fy)
		max_err_delta_mz = maxf(max_err_delta_mz, err_delta_mz)
		max_err_fy_total = maxf(max_err_fy_total, err_fy_tot)
		max_err_mz_total = maxf(max_err_mz_total, err_mz_tot)
		
		if err_fy_tot <= TOLERANCE and err_mz_tot <= TOLERANCE and err_fx_mf <= TOLERANCE:
			passed += 1
		else:
			failed += 1
			if failed <= 2:
				errors.append("Case %d discrepancy: Fy err=%.6f, Mz err=%.6f" % [idx, err_fy_tot, err_mz_tot])
				
	return {
		"name": "test_tire_parity",
		"passed": passed,
		"failed": failed,
		"errors": errors,
		"max_err_fy": max_err_fy_total,
		"max_err_mz": max_err_mz_total
	}
