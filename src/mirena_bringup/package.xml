<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mirena_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for Mirena Formula Student Driverless autonomy stack</description>
  <maintainer email="miguelozubas@gmail.com">Ozuba</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>mirena_slam</exec_depend>
  <exec_depend>mirena_planning</exec_depend>
  <exec_depend>mirena_control</exec_depend>
  <exec_depend>mirena_perception</exec_depend>
  <exec_depend>mirena_consensus</exec_depend>
  <exec_depend>mirena_supervisor</exec_depend>
  <exec_depend>mirena_hardware</exec_depend>
  <exec_depend>mirena_can_bus</exec_depend>
  <exec_depend>mirena_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
