#    && dpkg -i /tmp/ros2-apt-source.deb \
#    && rm /tmp/ros2-apt-source.deb
#
#RUN apt update && apt upgrade -y \
#    && apt install -y ros-jazzy-desktop \
#    && apt install -y ros-dev-tools \
#    && apt autoremove -y \
#    && apt clean \
#    && rm -rf /var/lib/apt/lists/*
#
## NVIDIA CUDA
#RUN apt update \
#    && apt install -y nvidia-cuda-toolkit libcudnn-dev 

# Set the default shell to source the ROS environment upon container startup
ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/jazzy/setup.bash && exec \"$@\"", "--"]
CMD ["/bin/bash"]