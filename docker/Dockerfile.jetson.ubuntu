FROM ubuntu:24.04

# Set environment to non-interactive to prevent install prompts
ENV DEBIAN_FRONTEND=noninteractive

# 
RUN apt update \
    && apt install -y software-properties-common locales curl wget zsh \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && export LANG=en_US.UTF-8 \
    && add-apt-repository universe

# NVIDIA SOURCES
RUN wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/arm64/cuda-keyring_1.1-1_all.deb \
    && dpkg -i cuda-keyring_1.1-1_all.deb \
    && rm cuda-keyring_1.1-1_all.deb \
    && curl -fsSL https://repo.download.nvidia.com/jetson/jetson-ota-public.asc  | gpg --dearmor -o /etc/apt/keyrings/nvidia-jetson-archive-keyring.gpg  \
    && echo "deb [signed-by=/etc/apt/keyrings/nvidia-jetson-archive-keyring.gpg] https://repo.download.nvidia.com/jetson/common r36.4 main" | tee /etc/apt/sources.list.d/nvidia-jetson.list \
    && echo "deb [signed-by=/etc/apt/keyrings/nvidia-jetson-archive-keyring.gpg] https://repo.download.nvidia.com/jetson/t234 r36.4 main" | tee -a /etc/apt/sources.list.d/nvidia-jetson.list  \
    && apt update \
    && apt install -y \
    nvidia-l4t-core 
    

# ROS2 INSTALLATION
