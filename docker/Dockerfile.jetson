# Deployment image of mirena_ws for nvidia jetson
FROM nvcr.io/nvidia/l4t-jetpack:r36.4.0

# ARGUMENTS FOR BUILDING
ARG USERNAME=mirena
ARG USER_UID=1000
ARG USER_GID=1000

# Place to download sources
ENV BUILD_DIR=/tmp


# Variables de Sistema
ENV DEBIAN_FRONTEND=noninteractive 
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# ROS2 CORE INSTALLATION

# Upgrade, Install basic tools, set locale, and enable required repositories
RUN apt update \
    && apt upgrade -y \
    && apt install -y \
        sudo \
        curl \
        wget \
        zsh \
        build-essential \
        software-properties-common \
        locales \
    \
    # Set the locale
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    \
    # Enable the Ubuntu Universe repository
    && add-apt-repository universe -y \
    \
    # Install the ROS 2 apt source configuration package
    && export ROS_APT_SOURCE_VERSION=$(curl -s https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest | grep -F "tag_name" | awk -F\" '{print $4}') \
    && curl -L -o /tmp/ros2-apt-source.deb "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.jammy_all.deb" \
    && dpkg -i /tmp/ros2-apt-source.deb \
    && rm -rf /var/lib/apt/lists/*


# Install development tools and ros-dev-tools
RUN apt update \
    && apt install -y \
    python3-flake8-blind-except \
    python3-flake8-class-newline \
    python3-flake8-deprecated \
    python3-mypy \
    python3-pip \
    python3-pytest \
    python3-pytest-cov \
    python3-pytest-mock \
    python3-pytest-repeat \
    python3-pytest-rerunfailures \
    python3-pytest-runner \
    python3-pytest-timeout \
    ros-dev-tools \
    # Install version control system (vcs) needed for cloning
    python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

# Create the workspace and clone the repositories
RUN mkdir -p ${BUILD_DIR}/ros/src 
# Clone the repositories for Jazzy + custom dependencies
WORKDIR ${BUILD_DIR}/ros
RUN vcs import --input https://raw.githubusercontent.com/ros2/ros2/jazzy/ros2.repos src

# Install dependencies using rosdep
# This step may take some time as it installs many Debian packages
RUN apt update  \
    && rosdep init \
    && rosdep update \
    # Install dependencies, ignoring packages that are built from source
    && rosdep install --from-paths ${BUILD_DIR}/ros/src --ignore-src -y --skip-keys "fastcdr rti-connext-dds-6.0.1 urdfdom_headers libopencv-dev libopencv-contrib-dev libopencv-imgproc-dev python-opencv python3-opencv"

# Build ROS 2 from source using colcon
# This is the longest step and is executed in a single layer to leverage Docker caching
RUN colcon build --continue-on-error --merge-install --install-base /opt/ros/jazzy



# ROS2 MIRENA_WS DEPS 
# Separated from core build to minimize rebuild times of container 
# CHANGE SHELL to be sourced inside the new ros2 installation
RUN mkdir -p ${BUILD_DIR}/mirena_overlay/src
WORKDIR ${BUILD_DIR}/mirena_overlay
COPY mirena_ws.repos .
RUN vcs import --input mirena_ws.repos src
RUN /bin/bash -c "source /opt/ros/jazzy/setup.bash && apt update && rosdep update \
    && rosdep install --from-paths ${BUILD_DIR}/mirena_overlay/src --ignore-src -y --rosdistro jazzy"
# Use a simple shell for the RUN command and source manually
RUN /bin/bash -c "source /opt/ros/jazzy/setup.bash && \
    colcon build --merge-install --install-base /opt/ros/jazzy --cmake-args -DBUILD_TESTING=OFF -DGTSAM_USE_SYSTEM_EIGEN=ON -DCMAKE_DISABLE_FIND_PACKAGE_benchmark=ON"


# SYSTEM packages
WORKDIR /opt

# ACADOS INSTALLATION
ENV ACADOS_SOURCE_DIR=/opt/acados
ENV LD_LIBRARY_PATH=/opt/acados/lib:$LD_LIBRARY_PATH
RUN git clone https://github.com/acados/acados.git && \
    cd acados && \
    git checkout 5847c74fe774137a5fb31c9791bf39aa980b8b05 && \
    git submodule update --recursive --init && \
    mkdir build && cd build && \
    cmake -DACADOS_WITH_QPOASES=ON \
          -DACADOS_WITH_OPENMP=ON \
          -DCMAKE_INSTALL_PREFIX=/opt/acados \
          .. && \
    make install -j$(nproc) && \
    pip install -e /opt/acados/interfaces/acados_template && \
    python3 -c "from acados_template.utils import get_tera; get_tera(force_download=True)"

# New Cmake
RUN apt-get update && apt-get install -y wget && \
    wget -q https://github.com/Kitware/CMake/releases/download/v3.29.2/cmake-3.29.2-linux-aarch64.tar.gz && \
    tar -xf cmake-3.29.2-linux-aarch64.tar.gz -C /usr/local --strip-components=1 && \
    rm cmake-3.29.2-linux-aarch64.tar.gz


# Open3D installation
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core Build Tools
    ccache git cmake build-essential \
    # Standard Open3D Script Dependencies
    xorg-dev libxcb-shm0 libglu1-mesa-dev python3-dev libssl-dev \
    libc++-dev libc++abi-dev libsdl2-dev libxi-dev libtbb-dev \
    libosmesa6-dev libudev-dev autoconf libtool gfortran \
    # Headers for "USE_SYSTEM" Optimizations
    libopenblas-dev liblapack-dev liblapacke-dev \
    libeigen3-dev libvtk9-dev libglfw3-dev libglew-dev \
    libfmt-dev libjsoncpp-dev libzmq3-dev pybind11-dev \
    libpng-dev libjpeg-dev \
    && rm -rf /var/lib/apt/lists/*
    
    RUN --mount=type=cache,target=/root/.cache/ccache \
    export DEBIAN_FRONTEND=noninteractive && \
    git clone --recursive  --depth 1 https://github.com/Ozuba/Open3D.git && \
    cd Open3D && \
    ./util/install_deps_ubuntu.sh assume-yes no-filament-deps && \
    mkdir build && cd build && \
    cmake -DBUILD_CUDA_MODULE=ON \
        -DUSE_SYSTEM_VTK=ON \
        -DUSE_SYSTEM_BLAS=ON \
        -DUSE_SYSTEM_EIGEN3=ON \
        -DUSE_SYSTEM_GLFW=OFF \
        -DUSE_SYSTEM_GLEW=ON \
        -DUSE_SYSTEM_FMT=ON \
        -DUSE_SYSTEM_JSONCPP=ON \
        -DUSE_SYSTEM_PNG=ON \
        -DUSE_SYSTEM_JPEG=ON \
        -DUSE_SYSTEM_CURL=ON \
        -DUSE_SYSTEM_TBB=ON \
        -DWITH_MINIZIP=ON \
        -DBUILD_UNIT_TESTS=OFF \
        -DWITH_IPP=OFF \
        -DBUILD_BENCHMARKS=OFF \
        -DBUILD_GUI=OFF \
        .. && \
    make install -j6 && \
    make install-pip-package -j6

# Install cudss
RUN wget https://developer.download.nvidia.com/compute/cudss/0.7.1/local_installers/cudss-local-tegra-repo-ubuntu2204-0.7.1_0.7.1-1_arm64.deb && \
    dpkg -i cudss-local-tegra-repo-ubuntu2204-0.7.1_0.7.1-1_arm64.deb && \
    cp /var/cudss-local-tegra-repo-ubuntu2204-0.7.1/cudss-*-keyring.gpg /usr/share/keyrings/ && \
    apt-get update && \
    apt-get -y install cudss && \
    # Cleanup to keep the image slim
    rm cudss-local-tegra-repo-ubuntu2204-0.7.1_0.7.1-1_arm64.deb

# Userspace

# Set primary and secondary indexes for all pip commands in the container
ENV PIP_INDEX_URL=https://pypi.jetson-ai-lab.io/jp6/cu126
#ENV PIP_EXTRA_INDEX_URL=https://pypi.org/simple

# System User Setup
SHELL ["/bin/bash", "-c"]
# Delete user if it exists in container (e.g Ubuntu Noble: ubuntu)
RUN if id -u $USER_UID ; then userdel `id -un $USER_UID` ; fi
# Create the user
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    # [Optional] Add sudo support. Omit if you don't need to install software after connecting.
    && apt-get update \
    && apt-get install -y sudo \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME



# Set workspace
USER $USERNAME
WORKDIR /home/mirena

# Installation of python deps
COPY requirements.txt /home/mirena
RUN pip install --no-cache-dir --index-url $PIP_INDEX_URL \
    torch torchvision torchaudio
RUN pip install --no-cache-dir -r /home/mirena/requirements.txt

# Install Oh My Zsh (non-interactively)
RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
# Copy Zshell config
COPY .zshrc /home/$USERNAME/

#SET default Shell for user
ENV SHELL=/bin/zsh
SHELL ["/bin/zsh", "-c"]

# Default launch command
ENTRYPOINT ["/bin/zsh"]
