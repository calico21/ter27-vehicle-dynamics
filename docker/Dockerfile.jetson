# Deployment image of mirena_ws for nvidia jetson
FROM nvcr.io/nvidia/l4t-base:r36.2.0

# User
ARG USERNAME=mirena
ARG USER_UID=1000
ARG USER_GID=1000

# System User Setup

# Delete user if it exists in container (e.g Ubuntu Noble: ubuntu)
RUN if id -u $USER_UID ; then userdel `id -un $USER_UID` ; fi
# Create the user
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    # [Optional] Add sudo support. Omit if you don't need to install software after connecting.
    && apt-get update \
    && apt-get install -y sudo \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME


# ROS2 Installation 
# Change the locale from POSIX to UTF-8
RUN locale-gen en_US en_US.UTF-8 && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8

# Install basic tools, set locale, and enable required repositories
RUN apt update \
    && apt install -y \
        sudo \
        curl \
        wget \
        build-essential \
        software-properties-common \
        locales \
    \
    # Set the locale
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    \
    # Enable the Ubuntu Universe repository
    && add-apt-repository universe -y \
    \
    # Install the ROS 2 apt source configuration package
    && export ROS_APT_SOURCE_VERSION=$(curl -s https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest | grep -F "tag_name" | awk -F\" '{print $4}') \
    && curl -L -o /tmp/ros2-apt-source.deb "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.noble_all.deb" \
    && dpkg -i /tmp/ros2-apt-source.deb \
    \
    && apt update

# Install development tools and ros-dev-tools
RUN apt install -y \
    python3-flake8-blind-except \
    python3-flake8-class-newline \
    python3-flake8-deprecated \
    python3-mypy \
    python3-pip \
    python3-pytest \
    python3-pytest-cov \
    python3-pytest-mock \
    python3-pytest-repeat \
    python3-pytest-rerunfailures \
    python3-pytest-runner \
    python3-pytest-timeout \
    ros-dev-tools \
    # Install version control system (vcs) needed for cloning
    python3-vcstool

# Create the workspace and clone the repositories
RUN mkdir -p ${ROS2_WS}/src \
    && cd ${ROS2_WS} \
    # Clone the repositories for Jazzy
    && vcs import --input https://raw.githubusercontent.com/ros2/ros2/jazzy/ros2.repos src

# Install dependencies using rosdep
# This step may take some time as it installs many Debian packages
RUN apt upgrade -y \
    && rosdep init \
    && rosdep update \
    # Install dependencies, ignoring packages that are built from source
    && rosdep install --from-paths ${ROS2_WS}/src --ignore-src -y --skip-keys "fastcdr rti-connext-dds-6.0.1 urdfdom_headers"

# Build ROS 2 from source using colcon
# This is the longest step and is executed in a single layer to leverage Docker caching
RUN cd ${ROS2_WS} \
    && colcon build --symlink-install --install-base /opt/ros/jazzy