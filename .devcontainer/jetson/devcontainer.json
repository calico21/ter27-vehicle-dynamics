{
  "name": "mirena_ws",
  "build": {
    "dockerfile": "../../docker/Dockerfile.jetson",
    "context": "../../docker/"
  },
  "runArgs": [
    "--privileged",
    "--runtime=nvidia",
    "--net=host",
    "--ipc=host",
    "--group-add",
    "44", // Numeric ID for video
    "--group-add",
    "992", // Numeric ID for render (matches your host)
    "--device=/dev/dri:/dev/dri",
    "-e",
    "DISPLAY=${localEnv:DISPLAY}",
    "-e",
    "QT_X11_NO_MITSHM=1",
    "-e",
    "NVIDIA_VISIBLE_DEVICES=all",
    "-e",
    "CUDA_FORCE_PTX_JIT=0",
    "-v",
    "/tmp/.X11-unix:/tmp/.X11-unix:rw",
    "-v",
    "/usr/share/vulkan/icd.d:/usr/share/vulkan/icd.d:ro",
     "-v",
    "/dev:/dev",
    "-v", 
    "/lib/modules:/lib/modules:ro"  
  ],
  "mounts": [
    "source=${localWorkspaceFolder},target=/home/mirena/mirena_ws,type=bind",
    "source=cuda_cache,target=/home/mirena/.nv/ComputeCache,type=volume" //Really Important Keeps the kernels cached so no hanging
  ],
  "postCreateCommand": "sudo chown -R mirena:mirena /home/mirena/.nv && sudo chmod -R 775 /home/mirena/.nv",//Fixes permissions for cuda cache
  "initializeCommand": "xhost +local:docker && xhost +local:root",
  "customizations": {
    "vscode": {
      "extensions": [
        "Ranch-Hand-Robotics.rde-ros-2",
        "ms-python.python",
        "ms-vscode.cpptools-extension-pack"
      ]
    },
    "settings": {
      "terminal.integrated.shell.linux": "/bin/zsh",
      "ROS2.distro": "jazzy"
    }
  }
}