{
  "name": "mirena_ws",
  "build": {
    "dockerfile": "../../docker/Dockerfile.jetson",
    "context": "../../docker/"
  },
  "runArgs": [
    "--privileged",
    "--runtime=nvidia",
    "--net=host",
    "--ipc=host",
    "--group-add",
    "44", // Numeric ID for video
    "--group-add",
    "992", // Numeric ID for render (matches your host)
    "--device=/dev/dri:/dev/dri",
    "-e",
    "DISPLAY=${localEnv:DISPLAY}",
    "-e",
    "QT_X11_NO_MITSHM=1",
    "-e",
    "NVIDIA_VISIBLE_DEVICES=all",
    "-v",
    "/tmp/.X11-unix:/tmp/.X11-unix:rw",
    "-v",
    "/usr/share/vulkan/icd.d:/usr/share/vulkan/icd.d:ro"
  ],
  "mounts": [
    "source=${localWorkspaceFolder},target=/home/mirena/mirena_ws,type=bind"
  ],
  "workspaceFolder": "/home/mirena/mirena_ws",
  "remoteUser": "mirena",
  "initializeCommand": "xhost +local:docker && xhost +local:root",
  "customizations": {
    "vscode": {
      "extensions": [
        "Ranch-Hand-Robotics.rde-ros-2",
        "ms-python.python",
        "ms-vscode.cpptools-extension-pack"
      ]
    },
    "settings": {
      "terminal.integrated.shell.linux": "/bin/zsh",
      "ROS2.distro": "jazzy"
    }
  }
}